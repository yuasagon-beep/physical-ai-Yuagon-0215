<?xml version="1.0"?>
<sdf version="1.8">
  <model name="mobile_base_test">
    <static>false</static>

    <!-- 車体：36cm x 30cm x 6cm -->
    <link name="chassis">
      <pose>0 0 0.095 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0156</ixx>
          <iyy>0.0222</iyy>
          <izz>0.0366</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box><size>0.36 0.30 0.06</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.36 0.30 0.06</size></box>
        </geometry>
        <material>
          <ambient>0.05 0.32 0.75 1</ambient>
          <diffuse>0.05 0.32 0.75 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 左駆動輪 -->
    <link name="left_wheel">
      <pose>-0.08 0.17 0.05 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00010355</ixx>
          <iyy>0.00010355</iyy>
          <izz>0.0001875</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.06 0.06 0.06 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 右駆動輪 -->
    <link name="right_wheel">
      <pose>-0.08 -0.17 0.05 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00010355</ixx>
          <iyy>0.00010355</iyy>
          <izz>0.0001875</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.06 0.06 0.06 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 前方の補助輪 -->
    <link name="caster">
      <pose>0.14 0 0.035 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000049</ixx>
          <iyy>0.000049</iyy>
          <izz>0.000049</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere><radius>0.035</radius></sphere>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.01</mu><mu2>0.01</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere><radius>0.035</radius></sphere>
        </geometry>
        <material>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 車輪の回転関節 -->
    <joint name="left_wheel_joint" type="revolute">
      <pose relative_to="left_wheel"/>
      <parent>chassis</parent>
      <child>left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1000000</lower>
          <upper>1000000</upper>
        </limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <pose relative_to="right_wheel"/>
      <parent>chassis</parent>
      <child>right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1000000</lower>
          <upper>1000000</upper>
        </limit>
      </axis>
    </joint>

    <joint name="caster_joint" type="ball">
      <parent>chassis</parent>
      <child>caster</child>
    </joint>

    <!-- Gazebo Fortress用の走行制御 -->
    <plugin
      filename="libignition-gazebo-diff-drive-system.so"
      name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.34</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>/model/mobile_base_test/cmd_vel</topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <max_linear_velocity>0.20</max_linear_velocity>
      <min_linear_velocity>-0.20</min_linear_velocity>
      <max_angular_velocity>0.8</max_angular_velocity>
      <min_angular_velocity>-0.8</min_angular_velocity>
    </plugin>
  </model>
</sdf>
